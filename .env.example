# Variables d'environnement — SRV-LINUX-IRIS
# Projet : IRIS-NICE-2024-RP01
#
# INSTRUCTIONS :
#   1. Copier ce fichier : cp .env.example .env
#   2. Remplacer TOUTES les valeurs <PLACEHOLDER> par vos mots de passe réels
#   3. NE JAMAIS commiter le fichier .env (déjà dans .gitignore)

# ── GLPI (Gestion de parc informatique) ───────────────────
GLPI_DB_ROOT_PASSWORD=<MOT_DE_PASSE_ROOT_MYSQL>
GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi
GLPI_DB_PASSWORD=<MOT_DE_PASSE_GLPI_DB>

# ── Nextcloud (Stockage fichiers) ─────────────────────────
NC_DB_ROOT_PASSWORD=<MOT_DE_PASSE_ROOT_MYSQL>
NC_DB_NAME=nextcloud
NC_DB_USER=nextcloud
NC_DB_PASSWORD=<MOT_DE_PASSE_NEXTCLOUD_DB>
NC_ADMIN_PASSWORD=<MOT_DE_PASSE_ADMIN_NEXTCLOUD>

# ── WireGuard VPN ─────────────────────────────────────────
WG_HOST_IP=192.168.50.20
WG_PASSWORD=<MOT_DE_PASSE_WIREGUARD>

# ── Grafana (Monitoring) ──────────────────────────────────
GRAFANA_PASSWORD=<MOT_DE_PASSE_GRAFANA_ADMIN>
